[Unit]
Description=Kronaxis learned prose-compressor (LLMLingua-2) for kronaxis-router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kronaxis
WorkingDirectory=/opt/prose-compressor
Environment=PROSE_PORT=8056
Environment=PROSE_DEVICE=cuda
# Pin to a dedicated GPU so the model never contends with other GPU workloads.
Environment=CUDA_VISIBLE_DEVICES=0
# Persist the HuggingFace model cache so restarts don't re-download.
Environment=HF_HOME=/var/cache/huggingface
ExecStart=/opt/prose-compressor/.venv/bin/python app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
